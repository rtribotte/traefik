{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/traefik/reference/main/schemas/oss/providers/knative.schema.json",
  "title": "Provider",
  "description": "Provider holds configurations of the provider.",
  "type": "object",
  "properties": {
    "certAuthFilePath": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "labelSelector": {
      "type": "string"
    },
    "namespaces": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "privateEntrypoints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "privateService": {
      "type": "object"
    },
    "publicEntrypoints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "publicService": {
      "type": "object"
    },
    "throttleDuration": {
      "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$",
      "type": "string"
    },
    "token": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
