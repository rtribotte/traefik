{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/traefik/reference/main/schemas/hub/middlewares/oauthintro.schema.json",
  "title": "OAuthIntrospection",
  "description": "Configuration configures an OAuth 2.0 Token Introspection middleware.",
  "type": "object",
  "properties": {
    "claims": {
      "type": "string"
    },
    "clientConfig": {
      "type": "object"
    },
    "forwardAuthorization": {
      "type": "boolean"
    },
    "forwardHeaders": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "tokenSource": {
      "type": "object"
    },
    "usernameClaim": {
      "type": "string"
    },
    "wwwAuthenticate": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
